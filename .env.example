# ==============================================================================
# CONFIGURACIÓN DEL PIPELINE - SISTEMA PREDICTIVO BIG DATA
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# ==============================================================================

# Entorno de ejecución: 'local' (almacenamiento en disco) o 'gcp' (Google Cloud: GCS + Dataproc + Cloud SQL)
PIPELINE_ENV=local

# ------------------------------------------------------------------------------
# Configuración Local
# ------------------------------------------------------------------------------
# Ruta base para datos locales (dejar vacío para usar 'data/' relativo a la raíz)
DATA_DIR=

# ------------------------------------------------------------------------------
# Configuración Google Cloud Platform (GCS / Dataproc / Cloud SQL)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=sistema-predictivo-bigdata
GCP_REGION=us-central1
GCS_BUCKET=sistema-predictivo-bigdata-lalibertad
DATAPROC_CLUSTER_NAME=cluster-dataproc-predictivo
# Ruta al archivo JSON de credenciales de Service Account (opcional si se usa gcloud auth / ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# Configuración de Apache Spark (PySpark 3.5.3 / Dataproc 2.2)
# ------------------------------------------------------------------------------
SPARK_APP_NAME=Sistema_Predictivo_La_Libertad
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8
SPARK_LOG_LEVEL=WARN

# ------------------------------------------------------------------------------
# Base de Datos de Serving y Control de Lotes (Cloud SQL: PostgreSQL / Local)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=epidemiologia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
