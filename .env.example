# ==============================================================================
# CONFIGURACIÓN DEL PIPELINE - SISTEMA PREDICTIVO BIG DATA
# Copia este archivo a .env y asigna los valores correspondientes.
# NUNCA subas el archivo .env real al control de versiones.
# ==============================================================================

# Entorno de ejecución: 'local' (almacenamiento en disco) o 'aws' (almacenamiento en S3)
PIPELINE_ENV=local

# ------------------------------------------------------------------------------
# Configuración Local
# ------------------------------------------------------------------------------
# Ruta base para datos locales (dejar vacío para usar 'data/' relativo a la raíz)
DATA_DIR=

# ------------------------------------------------------------------------------
# Configuración AWS Cloud (EMR / S3)
# ------------------------------------------------------------------------------
S3_BUCKET=sistema-predictivo-bigdata-lalibertad
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional si se usa emulador S3 (LocalStack / MinIO)
S3_ENDPOINT=

# ------------------------------------------------------------------------------
# Configuración de Apache Spark (PySpark 3.5.1)
# ------------------------------------------------------------------------------
SPARK_APP_NAME=Sistema_Predictivo_La_Libertad
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8
SPARK_LOG_LEVEL=WARN

# ------------------------------------------------------------------------------
# Base de Datos de Serving (PostgreSQL / AWS RDS)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=epidemiologia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMA=public
