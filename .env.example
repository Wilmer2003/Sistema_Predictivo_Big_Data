# ==============================================================================
# CONFIGURACIÓN DEL PIPELINE - SISTEMA PREDICTIVO BIG DATA
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# ==============================================================================

# Entorno de ejecución: 'local' (almacenamiento en disco) o 'aws' (Amazon Web Services: S3 + EMR + RDS)
PIPELINE_ENV=local

# ------------------------------------------------------------------------------
# Configuración Local
# ------------------------------------------------------------------------------
# Ruta base para datos locales (dejar vacío para usar 'data/' relativo a la raíz)
DATA_DIR=

# ------------------------------------------------------------------------------
# Configuración Amazon Web Services (AWS: S3 / EMR / RDS)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=sistema-predictivo-bigdata-lalibertad
EMR_CLUSTER_ID=j-XXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# Configuración de Apache Spark (PySpark 3.5.3 / Amazon EMR en YARN)
# ------------------------------------------------------------------------------
SPARK_APP_NAME=Sistema_Predictivo_La_Libertad
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8
SPARK_LOG_LEVEL=WARN

# ------------------------------------------------------------------------------
# Base de Datos de Serving y Control de Lotes (Amazon RDS PostgreSQL / Local)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=epidemiologia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
